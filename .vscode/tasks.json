{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Paper Notes：本地预览",
      "type": "shell",
      "command": "python3",
      "args": ["scripts/preview_site.py", "--open"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
